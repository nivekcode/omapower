#!/usr/bin/env bash
set -euo pipefail

plugin_dir=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/io.github.nivekcode.omapower
integration="$plugin_dir/integrations/omapower.bash"
bashrc=${HOME}/.bashrc
source_line="source \"$integration\""

[[ -f $integration ]] || { printf 'OmaPower integration not found: %s\n' "$integration" >&2; exit 1; }
touch "$bashrc"
if grep -Fqx "$source_line" "$bashrc"; then
  printf 'OmaPower Bash integration is already installed.\n'
else
  backup="${bashrc}.omapower-backup.$(date +%Y%m%d%H%M%S)"
  cp -p "$bashrc" "$backup"
  printf '\n# OmaPower terminal caret integration\n%s\n' "$source_line" >> "$bashrc"
  printf 'Installed OmaPower Bash integration. Backup: %s\n' "$backup"
fi

mode=$(omarchy-shell omapower set inputMode socket)
[[ $mode == '"socket"' ]] || {
  printf 'Could not switch OmaPower to socket mode.\n' >&2
  exit 1
}
# Omarchy writes plugin settings asynchronously. Give that write time to land
# before a caller restarts the shell.
sleep 1
printf 'OmaPower input mode set to socket for exact Bash tracking.\n'
