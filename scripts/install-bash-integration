#!/usr/bin/env bash
set -euo pipefail

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
integration="$plugin_dir/integrations/omapower.bash"
native_source="$plugin_dir/native/omapower-readline.c"
native_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omapower
native_output="$native_dir/omapower-readline.so"
bashrc=${HOME}/.bashrc
source_line="source \"$integration\""

[[ -f $integration ]] || { printf 'OmaPower integration not found: %s\n' "$integration" >&2; exit 1; }
[[ -f $native_source ]] || { printf 'OmaPower native source not found: %s\n' "$native_source" >&2; exit 1; }
command -v cc >/dev/null || { printf 'A C compiler is required to install the native Readline hook.\n' >&2; exit 1; }

mkdir -p "$native_dir"
native_tmp=$(mktemp "${native_dir}/.omapower-readline.so.XXXXXX")
trap 'rm -f "$native_tmp"' EXIT
cc -fPIC -shared -O2 -Wall -Wextra -Werror \
  -I/usr/include/bash -I/usr/include/bash/builtins -I/usr/include/bash/include \
  -o "$native_tmp" "$native_source"
chmod 755 "$native_tmp"
mv "$native_tmp" "$native_output"
trap - EXIT
printf 'Built the OmaPower native Readline hook.\n'

touch "$bashrc"
if grep -Fqx "$source_line" "$bashrc"; then
  printf 'OmaPower Bash integration is already installed.\n'
else
  backup="${bashrc}.omapower-backup.$(date +%Y%m%d%H%M%S)"
  cp -p "$bashrc" "$backup"
  printf '\n# OmaPower terminal caret integration\n%s\n' "$source_line" >> "$bashrc"
  printf 'Installed OmaPower Bash integration. Backup: %s\n' "$backup"
fi

mode=$(omarchy-shell omapower set inputMode socket)
[[ $mode == '"socket"' ]] || {
  printf 'Could not switch OmaPower to socket mode.\n' >&2
  exit 1
}
flash=$(omarchy-shell omapower set cursorFlash false)
[[ $flash == 'false' ]] || {
  printf 'Could not disable the OmaPower cursor flash.\n' >&2
  exit 1
}
# Omarchy writes plugin settings asynchronously. Give that write time to land
# before a caller restarts the shell.
sleep 1
printf 'OmaPower input mode set to the native Bash socket hook.\n'
printf 'OmaPower cursor flash disabled.\n'
