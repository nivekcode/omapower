#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: omapowerctl burst|enable|disable|toggle|reload|status' \
    '       omapowerctl set <setting> <value>' \
    '       omapowerctl caret <row> <column> <rows> <columns>'
}

command_name=${1:-}
case "$command_name" in
  burst|enable|disable|toggle|status)
    exec omarchy-shell omapower "$command_name"
    ;;
  reload)
    exec omarchy-shell omapower reloadSettings
    ;;
  set)
    [[ $# -eq 3 ]] || { usage >&2; exit 2; }
    exec omarchy-shell omapower set "$2" "$3"
    ;;
  caret)
    [[ $# -eq 5 ]] || { usage >&2; exit 2; }
    exec omarchy-shell omapower caret "$2" "$3" "$4" "$5"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
